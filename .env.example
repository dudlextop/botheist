DATABASE_URL="postgresql://USER@localhost:5432/botheist?schema=public"
SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_TX_VERSION="1"
VERIFIER_PUBKEY="<verifier public key>"
VERIFIER_KEYPAIR_PATH="/absolute/path/to/.keys/verifier.json"
PAYOUTS_ENABLED="true"
SESSION_SECRET="<32+ random bytes hex>"
# Optional. Players and organizers can bring their own Claude key in the UI.
# Without either, Milo runs as the offline scripted stand-in.
ANTHROPIC_API_KEY=""
# Optional: seals players' brought keys at rest (defaults to SESSION_SECRET).
KEY_SEAL_SECRET=""
